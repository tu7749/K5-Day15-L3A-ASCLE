# Caddy tự xin và gia hạn cert Let's Encrypt cho DOMAIN, chuyển HTTP sang HTTPS.
# DOMAIN đặt trong .env cạnh docker-compose.yml. Mặc định localhost (cert nội bộ, chỉ để thử trên máy).
{$DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy web:8501
}

# Truy cập HTTP bằng IP hoặc tên khác: chuyển về tên miền có cert, tránh lỗi cert khi vào https://<ip>.
http:// {
	redir https://{$DOMAIN:localhost}{uri} permanent
}
